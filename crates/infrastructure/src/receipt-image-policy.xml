<policymap>
  <policy domain="resource" name="thread" value="2"/>
  <policy domain="resource" name="time" value="40"/>
  <policy domain="resource" name="width" value="10000"/>
  <policy domain="resource" name="height" value="10000"/>
  <policy domain="resource" name="memory" value="256MiB"/>
  <policy domain="resource" name="map" value="0"/>
  <policy domain="resource" name="disk" value="512MiB"/>
  <policy domain="resource" name="list-length" value="8"/>
  <policy domain="delegate" rights="none" pattern="*"/>
  <policy domain="filter" rights="none" pattern="*"/>
  <policy domain="path" rights="none" pattern="@*"/>
  <policy domain="module" rights="none" pattern="*"/>
  <policy domain="module" rights="read|write" pattern="{HEIC,PNG,INFO}"/>
  <policy domain="coder" rights="none" pattern="*"/>
  <policy domain="coder" rights="read" pattern="{HEIC,HEIF}"/>
  <policy domain="coder" rights="write" pattern="{PNG,PNG24,INFO}"/>
</policymap>
